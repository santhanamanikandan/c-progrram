#include <stdio.h>
int main() {
    int n;
    printf("How many elements do you want?");
    scanf("%d",&n);
    int a[n];
    int i;
    for(i=0;i<n;i++){
        printf("Enter element %d:",i+1);
        scanf("%d",&a[i]);
    }
    printf("\nYour array elements are: ");
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    int temp;
    for (i=0;i<n-1;i++){
        int j;
        for (j=0;j<n-1-i;j++){
            if(a[j]>a[j+1]){
                int temp=a[j];
                 a[j]=a[j+1];
                 a[j+1]=temp;
            }
        }
    }
    printf("\nYour array elements are: ");
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    printf("\nStart small. Ship something.\n");
    return 0;
    
    
}
