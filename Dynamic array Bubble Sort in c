#include <stdio.h>
int main(){
    int row;
    int cum;
    int i,j;
    printf("How many rows do you want? ");
    scanf("%d",&row);
    printf("How many columns do you want? ");
    scanf("%d",&cum);
    int a[row][cum];
    for (i=0;i<row;i++) {
        for (j=0;j<cum;j++) {
            printf("Enter a number for row %d, column %d:",i+1,j+1);
            scanf("%d",&a[i][j]);
        }
    }
    for (i=0;i<row;i++) {
        for (j=0;j<cum;j++) {
            printf("%d\t",a[i][j]);
        }
        printf("\n");
        
    }
    int x;
    for (x=0;x<row;x++) {
        int temp;
        for (i=0;i<cum;i++) {
            for (j=0;j<cum-i-1;j++){
                if (a[x][j]>a[x][j+1]){
                    temp = a[x][j];
                    a[x][j]=a[x][j+1];
                    a[x][j+1]=temp;
                }
                
            }
                
                
        }
    }
    for (i=0;i<row;i++) {
        for (j=0;j<cum;j++) {
            printf("%d\t",a[i][j]);
        }
        printf("\n");
        
    }
    for (x=0;x<cum;x++) {
        int temp;
        for (i=0;i<row;i++) {
            for (j=0;j<row-i-1;j++){
                if  (a[j][x]>a[j+1][x]){
                    temp = a[j][x];
                    a[j][x]=a[j+1][x];
                    a[j+1][x] = temp;
                }
            }
            
        }            
    }                
    for (i=0;i<row;i++) {
        for (j=0;j<cum;j++) {
            printf("%d\t",a[i][j]);
        }
        printf("\n");
        
    }       
    return 0;
}
